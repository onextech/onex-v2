{
  "extends": "@gravis-os/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@app/*": ["./src/*"],
      "@public/*": ["./public/*"],
      "@pages/*": ["./pages/*"],
      "@onex/components/*": ["../../packages/components/src/*"],
      "@/components/*": ["../../packages/components/src/*"],
    },
    "strictNullChecks": false,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".eslintrc.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
